# ==============================================
# KONFIGURASI EMAIL UNTUK CREDENTIALS MUZAKKI
# ==============================================

# Pilih salah satu konfigurasi di bawah sesuai kebutuhan

# ---------------------------------------------
# PILIHAN 1: GMAIL (Development/Testing)
# ---------------------------------------------
# 1. Aktifkan 2-Step Verification di Gmail
# 2. Generate App Password di https://myaccount.google.com/security
# 3. Copy 16-karakter App Password ke MAIL_PASSWORD
#
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=emailkamu@gmail.com
# MAIL_PASSWORD="xxxx xxxx xxxx xxxx"
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=emailkamu@gmail.com
# MAIL_FROM_NAME="UPZ Zakat UNSIL"

# ---------------------------------------------
# PILIHAN 2: MAILTRAP (Testing Only)
# ---------------------------------------------
# Tangkap email untuk testing tanpa kirim asli
# Daftar gratis di https://mailtrap.io
#
# MAIL_MAILER=smtp
# MAIL_HOST=sandbox.smtp.mailtrap.io
# MAIL_PORT=2525
# MAIL_USERNAME=your_mailtrap_username
# MAIL_PASSWORD=your_mailtrap_password
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=noreply@upz.unsil.ac.id
# MAIL_FROM_NAME="UPZ Zakat UNSIL"

# ---------------------------------------------
# PILIHAN 3: SMTP SERVER UNSIL (Production)
# ---------------------------------------------
# Hubungi IT UNSIL untuk credentials
#
# MAIL_MAILER=smtp
# MAIL_HOST=mail.unsil.ac.id
# MAIL_PORT=587
# MAIL_USERNAME=upz@unsil.ac.id
# MAIL_PASSWORD=your_password
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=noreply@upz.unsil.ac.id
# MAIL_FROM_NAME="UPZ Zakat UNSIL"

# ---------------------------------------------
# PILIHAN 4: SENDGRID (Production Scale)
# ---------------------------------------------
# Gratis 100 email/hari
# Daftar di https://sendgrid.com
#
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.sendgrid.net
# MAIL_PORT=587
# MAIL_USERNAME=apikey
# MAIL_PASSWORD=your_sendgrid_api_key
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=noreply@upz.unsil.ac.id
# MAIL_FROM_NAME="UPZ Zakat UNSIL"

# ---------------------------------------------
# KONFIGURASI WHATSAPP SERVICE
# ---------------------------------------------
WHATSAPP_SERVICE_URL=http://localhost:3001

# Catatan: Hapus trailing slash (/) di akhir URL
# ✅ Benar: http://localhost:3001
# ❌ Salah: http://localhost:3001/
