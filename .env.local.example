# Local Development Environment
# Copy to .env.local dan gunakan untuk development lokal

APP_NAME="UPZ UNSIL"
APP_ENV=local
APP_DEBUG=true

# LOCAL PostgreSQL (Install PostgreSQL di laptop)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=upz_local
DB_USERNAME=postgres
DB_PASSWORD=password

# Atau gunakan SQLite untuk development (lebih mudah)
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

# API URL
VITE_API_URL=http://localhost:8000/api
